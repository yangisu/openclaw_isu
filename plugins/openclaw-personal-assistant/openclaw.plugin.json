{
  "id": "openclaw-personal-assistant",
  "name": "OpenClaw Personal Assistant",
  "description": "Owner-scoped local records, Naver calendar, and briefings.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "required": [
      "workspaceDir",
      "stateDir",
      "backupDir",
      "telegramUserId",
      "timezone"
    ],
    "properties": {
      "workspaceDir": {
        "type": "string",
        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      },
      "stateDir": {
        "type": "string",
        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      },
      "backupDir": {
        "type": "string",
        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      },
      "telegramUserId": {
        "type": "string",
        "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
        "maxLength": 19
      },
      "timezone": {
        "type": "string",
        "const": "Asia/Seoul"
      },
      "calendar": {
        "type": "object",
        "properties": {
          "caldavBaseUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "caldavSecretFile": {
            "type": "string",
            "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "naverTokenFile": {
            "type": "string",
            "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "assistant_query",
      "assistant_mutate",
      "assistant_calendar_prepare",
      "assistant_calendar_confirm",
      "assistant_briefing"
    ]
  },
  "toolMetadata": {
    "assistant_query": {
      "optional": true
    },
    "assistant_mutate": {
      "optional": true
    },
    "assistant_calendar_prepare": {
      "optional": true
    },
    "assistant_calendar_confirm": {
      "optional": true
    },
    "assistant_briefing": {
      "optional": true
    }
  }
}
