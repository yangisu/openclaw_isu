{
  "id": "openclaw-personal-assistant",
  "name": "OpenClaw Personal Assistant",
  "description": "Owner-scoped local records, Naver calendar, and briefings.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "required": [
      "workspaceDir",
      "stateDir",
      "backupDir",
      "telegramUserId",
      "timezone"
    ],
    "properties": {
      "workspaceDir": {
        "type": "string",
        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      },
      "stateDir": {
        "type": "string",
        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      },
      "backupDir": {
        "type": "string",
        "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      },
      "telegramUserId": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "timezone": {
        "type": "string",
        "const": "Asia/Seoul"
      },
      "calendar": {
        "type": "object",
        "properties": {
          "caldavBaseUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "caldavSecretFile": {
            "type": "string",
            "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          },
          "naverTokenFile": {
            "type": "string",
            "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$)).+"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "assistant_query",
      "assistant_mutate",
      "assistant_calendar_prepare",
      "assistant_calendar_confirm"
    ]
  },
  "toolMetadata": {
    "assistant_query": {
      "optional": true
    },
    "assistant_mutate": {
      "optional": true
    },
    "assistant_calendar_prepare": {
      "optional": true
    },
    "assistant_calendar_confirm": {
      "optional": true
    }
  }
}
