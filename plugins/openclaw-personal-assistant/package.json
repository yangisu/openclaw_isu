{
  "name": "@local/openclaw-personal-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "openclaw-personal-assistant": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build",
    "plugin:validate": "npm run plugin:build && node scripts/validate-mixed-entry.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.0",
    "ical.js": "2.2.1",
    "typebox": "1.3.18"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
